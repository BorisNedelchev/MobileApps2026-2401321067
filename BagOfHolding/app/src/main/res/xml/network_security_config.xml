<?xml version="1.0" encoding="utf-8"?>
<!--
    Inventory sharing talks plain HTTP to another phone on the same Wi-Fi (e.g. http://192.168.1.23:47321).
    Android blocks cleartext HTTP by default and domain-config cannot match IP ranges,
    so cleartext is allowed app-wide. The app never contacts the internet, only the local network.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
